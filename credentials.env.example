# --- Obligatorio (de tinytuya wizard + tu router) ---
DEVICE_ID="bfd496de920b51bdb7pee4"
DEVICE_IP_ADDRESS="192.168.1.XX"      # IP LOCAL del enchufe, no la publica
LOCAL_KEY="pon-aqui-la-local-key"

# --- Enchufe ---
TUYA_VERSION=3.3          # 3.3, 3.4 o 3.5 (lo muestra: python -m tinytuya scan)
SWITCH_DP=1
POWER_DP=19               # DPS de potencia; comprueba con: python alc.py --probe
POWER_SCALE=10            # 19 suele venir en decimas de vatio

# --- Umbrales ---
BATTERY_LOW=20
BATTERY_HIGH=80
BATTERY_ABS_MAX=90        # corte de seguridad
POLL_SECONDS=60
MAX_CHARGE_MINUTES=360

# --- Que dispositivo carga este enchufe ---
TARGET_DEVICE=local       # "local" = este portatil; o un nombre, ej. "movil"
REMOTE_PORT=0             # 8765 para recibir porcentajes de otros dispositivos
REMOTE_TOKEN=""           # pon una clave si activas REMOTE_PORT
REMOTE_MAX_AGE=600        # segundos de validez de un dato remoto

# --- Estimacion por consumo (solo si no hay porcentaje real) ---
CAPACITY_WH=50            # portatil ~50-70 Wh, telefono ~15-20 Wh
CHARGE_EFFICIENCY=0.85
EST_START_PERCENT=50
EST_DRAIN_PCT_PER_HOUR=8
FULL_RATIO=0.15           # fin de carga si potencia < 15% del maximo visto
FULL_ABS_W=5
MIN_CHARGE_W=15
FULL_SAMPLES=5
