# --- Obligatorio (de tinytuya wizard + tu router) ---
DEVICE_ID="bfd496de920b51bdb7pee4"
DEVICE_IP_ADDRESS="192.168.1.XX"      # IP LOCAL del enchufe, no la publica
LOCAL_KEY="pon-aqui-la-local-key"

# --- Enchufe ---
TUYA_VERSION=3.3          # 3.3, 3.4 o 3.5 (lo muestra: python -m tinytuya scan)
SWITCH_DP=1
POWER_DP=19               # DPS de potencia; comprueba con: python alc.py --probe
POWER_SCALE=10            # 19 suele venir en decimas de vatio

# --- Umbrales ---
BATTERY_LOW=20
BATTERY_HIGH=80
BATTERY_ABS_MAX=90        # corte de seguridad
POLL_SECONDS=60
MAX_CHARGE_MINUTES=360

# --- Que dispositivo carga este enchufe ---
TARGET_DEVICE=local       # "local" = este portatil; o un nombre, ej. "movil"
REMOTE_PORT=0             # 8765 para recibir porcentajes de otros dispositivos
REMOTE_TOKEN=""           # pon una clave si activas REMOTE_PORT
REMOTE_MAX_AGE=600        # segundos de validez de un dato remoto

# --- Estimacion por consumo (solo si no hay porcentaje real) ---
CAPACITY_WH=50            # portatil ~50-70 Wh, telefono ~15-20 Wh
CHARGE_EFFICIENCY=0.85
EST_START_PERCENT=50
EST_DRAIN_PCT_PER_HOUR=8
FULL_RATIO=0.15           # fin de carga si potencia < 15% del maximo visto
FULL_ABS_W=5
MIN_CHARGE_W=15
FULL_SAMPLES=5

# --- Reglas e historial (aprendizaje) ---
RULES_FILE=rules.toml        # copia rules.example.toml a rules.toml
HISTORY_DB=autocharging.db   # vacio = sin historial ni aprendizaje

# --- Home Assistant (opcional) ---
# Con HA_SWITCH_ENTITY el enchufe se controla desde Home Assistant en lugar de Tuya local
# (entonces DEVICE_ID, DEVICE_IP_ADDRESS y LOCAL_KEY no hacen falta).
# PLUG_BACKEND=homeassistant
# HA_URL=http://homeassistant.local:8123     # Home Assistant Green; en Windows, la IP de la maquina virtual
# HA_TOKEN=pega-aqui-el-token-de-acceso-de-larga-duracion
# HA_SWITCH_ENTITY=switch.cargador_movil
# HA_POWER_ENTITY=sensor.cargador_movil_potencia
# HA_BATTERY_ENTITY=sensor.pixel_8_battery_level        # iPhone: sensor.iphone_battery_level
# HA_BATTERY_STATE_ENTITY=sensor.pixel_8_battery_state
# HA_PLUGGED_ENTITY=                                     # opcional
# HA_NOTIFY_SERVICE=notify.mobile_app_pixel_8            # opcional
# HA_MAX_AGE_MINUTES=180                                 # dato de bateria mas antiguo = se ignora
# HA_SETTLE_SECONDS=1.5                                  # sube a 5-10 si la integracion del enchufe tarda en actualizar
